# Copy to .env (never commit .env). Read by the gateway and the workers; see
# packages/core/sherlock_core/config.py for every setting.

# --- Supabase (gateway + workers; server side only, never ship the service key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- service wiring
# Shared secret that signs the gateway -> worker wake calls. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_SECRET=
# Public base URL of each worker (docker compose overrides these with service names)
WORKER_URL_IDENTITY=http://localhost:8101
WORKER_URL_INFRA=http://localhost:8102
WORKER_URL_MEDIA=http://localhost:8103
# Which queue a worker process serves: identity | infra | media (set per worker)
WORKER_QUEUE=identity
# Comma-separated browser origins allowed by CORS (localhost:3000 is always allowed)
FRONTEND_ORIGINS=http://localhost:3000
# Operator panel (/admin): comma-separated emails of signed-in accounts with a confirmed email.
# Case-insensitive. Empty means nobody can open the panel.
ADMIN_EMAILS=

# --- LLM (agent + variations)
MODEL_NAME=gemma-4-26b-a4b-it
GOOGLE_API_KEY=

# --- optional module keys; modules without their key report themselves unavailable
SERPAPI_KEY=
GITHUB_TOKEN=
SCRAPING_API_KEY=

# --- limits (defaults shown)
# Searches need a signed-in account (false lets anonymous sessions search; name search always needs one)
# REQUIRE_SIGN_IN=true
# SCANS_PER_SESSION_PER_DAY=20
# SCANS_GLOBAL_PER_DAY=300
# NAME_SEARCHES_PER_USER_PER_DAY=5
# Short bursts (fixed 10-minute windows) and per-origin limits (hashed client IP, so a private
# window does not reset them). The operator (ADMIN_EMAILS) is exempt from session/origin limits.
# SEARCHES_PER_SESSION_PER_10M=3
# SEARCHES_PER_ORIGIN_PER_10M=5
# SEARCHES_PER_ORIGIN_PER_DAY=30
# Unfinished searches per session at once (0 = no check)
# ACTIVE_SEARCHES_PER_SESSION=1
# Refuse new searches (503) while a queue holds more queued jobs than this (0 = off)
# QUEUE_BACKLOG_MAX=80
# Rough seconds per job, only for the estimated wait shown to waiting visitors
# QUEUE_AVG_JOB_SECONDS=15
# LLM_CALLS_PER_SESSION_PER_DAY=60
# JOB_STALE_SECONDS=120
# MAX_CONCURRENCY=20
# Worker: jobs run at once per worker (at most one heavy module such as whatsmyname among them)
# WORKER_CONCURRENCY=3
# Worker: profile-preview / avatar downloads in flight at once, shared by all its jobs
# ENRICH_CONCURRENCY=4
COMPANIES_HOUSE_API_KEY=

# Set to 1 only on a host with a full CPU: enables the 2,500-site username sweep (too slow for a free instance).
USER_SCANNER_USERNAMES=

# Only for a second deployment that shares the database (e.g. local next to live): QUEUE_PREFIX=local-
QUEUE_PREFIX=
