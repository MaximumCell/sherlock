# Sherlock queue worker. One image, deployed once per queue (WORKER_QUEUE=identity|infra|media).
# Build from the repo root: docker build -f Dockerfile.worker -t sherlock-worker .
FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_NO_CACHE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Dependencies first (cached until a pyproject or the lock changes). uv needs every
# workspace member's pyproject to read the lock, but only this service gets installed.
COPY pyproject.toml uv.lock ./
COPY packages/core/pyproject.toml packages/core/pyproject.toml
COPY services/gateway/pyproject.toml services/gateway/pyproject.toml
COPY services/worker/pyproject.toml services/worker/pyproject.toml
RUN uv sync --frozen --no-dev --no-install-workspace --package sherlock-worker

COPY packages/core packages/core
COPY services/worker services/worker
RUN uv sync --frozen --no-dev --package sherlock-worker \
    && useradd --system --uid 10001 --no-create-home sherlock

USER sherlock
EXPOSE 8000

# One process and one drain loop per instance: jobs run one at a time on 0.1 CPU.
CMD ["sh", "-c", "exec uvicorn worker.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
